{
  "name": "employee-portal-v2",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 3000",
    "dev:frontend": "npm run dev --workspace frontend",
    "db:migrate": "python backend/app/db_scripts/migrate.py",
    "db:seed": "python backend/app/db_scripts/seed.py",
    "db:reset": "python backend/app/db_scripts/reset.py",
    "test:backend": "cd backend && python -m pytest -q",
    "test:frontend": "npm run test --workspace frontend -- run",
    "test:e2e": "playwright test",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "concurrently": "^9.1.0"
  }
}
