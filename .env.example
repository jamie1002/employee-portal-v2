# 開發資料庫（docker-compose 的 postgres-dev）。
# 用 5442/5443 而非預設的 5432/5433，因為舊專案 employee-portal 的
# docker-compose 佔用了 5432/5433，這樣兩個專案可以同時開著互相對照。
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/employee_portal

# 測試資料庫（docker-compose 的 postgres-test）——名稱必須以 _test 結尾，
# 測試 helper 執行 DROP SCHEMA 前會驗證這件事，見 docs/PITFALLS.md A1。
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5443/employee_portal_test

# openssl rand -base64 48
JWT_SECRET=<請自行產生，本機開發可用任意長字串>
JWT_EXPIRES_IN_HOURS=24

APP_TIMEZONE=Asia/Taipei
CORS_ORIGINS=http://localhost:5173

# 正式環境（ENVIRONMENT=production）才會啟動閒置自動重置排程，設為 0 可關閉
DEMO_RESET_IDLE_MINUTES=15

PORT=3000

# AI 政策問答（批 A）。留空即視為未啟用（/api/chat 一律回 503 CHAT_UNAVAILABLE），
# 見 openspec/changes/add-policy-chat/design.md。到 https://aistudio.google.com/apikey 申請。
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 只作用在批次作業（db:ingest／eval:chat）；互動問答刻意不節流，配額保護交給
# CHAT_RATE_LIMIT_PER_MINUTE（明確回 429 比默默拖慢每次回答誠實）。
GEMINI_REQUESTS_PER_MINUTE=10
# 免費層生成延遲抖動大（實測同樣輸入 1.5～8.4 秒），放寬以降低偶發的 503。
GEMINI_TIMEOUT_SECONDS=40
# 影響用詞隨機性，不是「語氣溫暖度」；調整後必須重跑 npm run eval:chat。
GEMINI_TEMPERATURE=0.3
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768
RETRIEVAL_TOP_K=5
# 綁死在「這個模型 + 768 維 + 兩側 L2 正規化 + 不對稱 task_type」這一整組設定上，
# 任一項變動即作廢，須重跑 backend/eval/measure_min_score.py 重新校準。
RETRIEVAL_MIN_SCORE=0.65
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_MAX_QUESTION_CHARS=500
# 整趟問答的上限。GEMINI_TIMEOUT_SECONDS 管的是「單次呼叫」，但批 B 帶工具時一次提問
# 會有兩次呼叫，最壞情況會變成兩倍——讓使用者等那麼久才看到失敗訊息並不誠實。
CHAT_TOTAL_TIMEOUT_SECONDS=60
